# Fill these provider settings before starting the service. No provider is selected.
ARTICLE_GRAPH_LLM__BASE_URL=
ARTICLE_GRAPH_LLM__API_KEY=
ARTICLE_GRAPH_LLM__TEXT_MODEL=
# Confirm your provider supports this mode: json_object or json_schema; no fallback.
ARTICLE_GRAPH_LLM__OUTPUT_MODE=json_object
# For PDF/images, explicitly configure a model supporting image_url data URLs.
# ARTICLE_GRAPH_LLM__VISION_MODEL=your-vision-model
# Provider example only: BASE_URL=https://api.deepseek.com, TEXT_MODEL=deepseek-flash

# Local development credentials below are PUBLIC examples, not production secrets.
# They work for a disposable local review. Use fresh values for other deployments.
# APP_TOKEN, JWT_ACCESS_KEY and JWT_REFRESH_KEY must be independent (32+ chars).
ARTICLE_GRAPH_APP_TOKEN=zdgdyGUuQQj7jXvmH7PGu8ms87SZcNQRS_iQwrBDoD4
ARTICLE_GRAPH_JWT_ACCESS_KEY=3uexVC8r3CoFIjnbSxPweVxumwfrW4D7CpPhTDq05OY
ARTICLE_GRAPH_JWT_REFRESH_KEY=2Q80g-l95-gnP2AYQsK0_1Qso0VSj4Cxr_OPge8tFfQ
ARTICLE_GRAPH_JWT_ISSUER=article-graph
ARTICLE_GRAPH_JWT_AUDIENCE=article-graph-api
ARTICLE_GRAPH_APP_ID=article-graph-app
ARTICLE_GRAPH_APP_NAME=Article Graph
ARTICLE_GRAPH_NEO4J__URI=bolt://127.0.0.1:7687
ARTICLE_GRAPH_NEO4J__USERNAME=neo4j
ARTICLE_GRAPH_NEO4J__PASSWORD=13cSadBlBbXwdQheoqQai95iWuf8KARC34b4-pNU9Fo
ARTICLE_GRAPH_NEO4J__DATABASE=neo4j
# bge-m3; must match the existing index (changing it requires an explicit migration).
ARTICLE_GRAPH_NEO4J__EMBEDDING_DIMENSIONS=1024
# Explicit embedding configuration. Compose automatically pulls and verifies this model.
# Export these variables for `python -m article_graph.embeddings` (no .env loading).
ARTICLE_GRAPH_OLLAMA__BASE_URL=http://127.0.0.1:11434
ARTICLE_GRAPH_OLLAMA__MODEL=bge-m3:567m
ARTICLE_GRAPH_OLLAMA__DIGEST=7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab
ARTICLE_GRAPH_OLLAMA__DIMENSIONS=1024
ARTICLE_GRAPH_OLLAMA__TIMEOUT_SECONDS=60
ARTICLE_GRAPH_LLM__TIMEOUT_SECONDS=30
ARTICLE_GRAPH_LLM__MAX_TOKENS=4096
ARTICLE_GRAPH_LLM__MAX_RESPONSE_BYTES=2000000
# P15 worker: use the same persistent blob directory as the upload process.
ARTICLE_GRAPH_WORKER__BROKER_URL=redis://127.0.0.1:6379/0
ARTICLE_GRAPH_WORKER__BLOB_ROOT=./.data/blobs
ARTICLE_GRAPH_BLOB_ROOT=./.data/blobs
ARTICLE_GRAPH_WORKER__LEASE_SECONDS=120
ARTICLE_GRAPH_WORKER__HEARTBEAT_SECONDS=15
# P16 independent dispatcher: point at the same broker/queue as the worker.
ARTICLE_GRAPH_DISPATCHER__BROKER_URL=redis://127.0.0.1:6379/0
ARTICLE_GRAPH_DISPATCHER__CLAIM_SECONDS=60
ARTICLE_GRAPH_DISPATCHER__REDELIVERY_SECONDS=600
ARTICLE_GRAPH_DISPATCHER__POLL_SECONDS=1
ARTICLE_GRAPH_DISPATCHER__BATCH_SIZE=100
ARTICLE_GRAPH_DISPATCHER__RETRY_SECONDS=2
ARTICLE_GRAPH_DISPATCHER__RETRY_MAX_SECONDS=60
# Optional resource limit overrides (see docs/contracts.md).
# ARTICLE_GRAPH_LIMITS__UPLOAD_BYTES=2097152
# ARTICLE_GRAPH_LIMITS__PDF_PAGES=20
# ARTICLE_GRAPH_LIMITS__PDF_DPI=144
# ARTICLE_GRAPH_LIMITS__PAGE_PIXELS=4000000
# ARTICLE_GRAPH_LIMITS__PDF_TOTAL_PIXELS=40000000
# ARTICLE_GRAPH_LIMITS__PDF_TIMEOUT_SECONDS=30
