# Development example only. Set a unique value before using the application.
ARTICLE_GRAPH_APP_TOKEN=replace-with-a-unique-token-of-at-least-32-characters
ARTICLE_GRAPH_APP_NAME=Article Graph
ARTICLE_GRAPH_NEO4J__URI=bolt://127.0.0.1:7687
ARTICLE_GRAPH_NEO4J__USERNAME=neo4j
ARTICLE_GRAPH_NEO4J__PASSWORD=replace-with-your-database-password
ARTICLE_GRAPH_NEO4J__DATABASE=neo4j
# bge-m3; must match the existing index (changing it requires an explicit migration).
ARTICLE_GRAPH_NEO4J__EMBEDDING_DIMENSIONS=1024
# Optional resource limit overrides (see docs/contracts.md).
# ARTICLE_GRAPH_LIMITS__UPLOAD_BYTES=2097152
# ARTICLE_GRAPH_LIMITS__PDF_PAGES=20
# ARTICLE_GRAPH_LIMITS__PAGE_DEFAULT=20
# ARTICLE_GRAPH_LIMITS__PAGE_MAX=100
