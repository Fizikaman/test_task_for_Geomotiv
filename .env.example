# Development example only. Set a unique value before using the application.
ARTICLE_GRAPH_APP_TOKEN=replace-with-a-unique-token-of-at-least-32-characters
# Independent random signing keys, distinct from each other and the App Token.
ARTICLE_GRAPH_JWT_ACCESS_KEY=replace-with-a-unique-access-key-of-at-least-32-characters
ARTICLE_GRAPH_JWT_REFRESH_KEY=replace-with-a-unique-refresh-key-of-at-least-32-characters
ARTICLE_GRAPH_JWT_ISSUER=article-graph
ARTICLE_GRAPH_JWT_AUDIENCE=article-graph-api
ARTICLE_GRAPH_APP_ID=article-graph-app
ARTICLE_GRAPH_APP_NAME=Article Graph
ARTICLE_GRAPH_NEO4J__URI=bolt://127.0.0.1:7687
ARTICLE_GRAPH_NEO4J__USERNAME=neo4j
ARTICLE_GRAPH_NEO4J__PASSWORD=replace-with-your-database-password
ARTICLE_GRAPH_NEO4J__DATABASE=neo4j
# bge-m3; must match the existing index (changing it requires an explicit migration).
ARTICLE_GRAPH_NEO4J__EMBEDDING_DIMENSIONS=1024
# Explicit embedding configuration; copy the installed model digest from /api/tags.
# Export these variables for `python -m article_graph.embeddings` (no .env loading).
ARTICLE_GRAPH_OLLAMA__BASE_URL=http://127.0.0.1:11434
ARTICLE_GRAPH_OLLAMA__MODEL=bge-m3:latest
ARTICLE_GRAPH_OLLAMA__DIGEST=replace-with-the-64-character-installed-model-digest
ARTICLE_GRAPH_OLLAMA__DIMENSIONS=1024
# Provider URL, key, text model and output mode are required at application startup.
# Example for a local check: BASE_URL=https://api.deepseek.com/v1, TEXT_MODEL=deepseek-chat
ARTICLE_GRAPH_LLM__BASE_URL=https://your-provider.example/v1
ARTICLE_GRAPH_LLM__API_KEY=replace-with-your-provider-key
ARTICLE_GRAPH_LLM__TEXT_MODEL=replace-with-your-text-model
# Set only after confirming that this provider/model supports image_url data URLs.
# ARTICLE_GRAPH_LLM__VISION_MODEL=your-vision-model
ARTICLE_GRAPH_LLM__TIMEOUT_SECONDS=30
# Explicit provider capability: json_object or json_schema; no automatic fallback.
ARTICLE_GRAPH_LLM__OUTPUT_MODE=json_object
ARTICLE_GRAPH_LLM__MAX_TOKENS=4096
ARTICLE_GRAPH_LLM__MAX_RESPONSE_BYTES=2000000
# Optional resource limit overrides (see docs/contracts.md).
# ARTICLE_GRAPH_LIMITS__UPLOAD_BYTES=2097152
# ARTICLE_GRAPH_LIMITS__PDF_PAGES=20
# ARTICLE_GRAPH_LIMITS__PDF_DPI=144
# ARTICLE_GRAPH_LIMITS__PAGE_PIXELS=4000000
# ARTICLE_GRAPH_LIMITS__PDF_TOTAL_PIXELS=40000000
# ARTICLE_GRAPH_LIMITS__PDF_TIMEOUT_SECONDS=30
# ARTICLE_GRAPH_LIMITS__PDF_MEMORY_BYTES=536870912
# ARTICLE_GRAPH_LIMITS__PAGE_DEFAULT=20
# ARTICLE_GRAPH_LIMITS__PAGE_MAX=100
